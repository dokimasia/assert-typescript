{
  // Emitting is a separate concern from checking: the base config
  // covers tests and tools too, and those never ship.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  // tools/dist.ts copies the declarations of each vitest major beside the
  // emitted ones.
  "exclude": ["src/**/*.test.ts", "src/vitest/*.d.ts"]
}
