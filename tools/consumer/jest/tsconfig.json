{
  // The type probes of the consumer project, in the two declaration styles
  // of jest, with the declarations of its dependencies checked.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "jest"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "files": ["globals.types.ts", "global.types.ts"]
}
