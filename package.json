{
  "name": "@dokimi/assert",
  "version": "0.2.0",
  "description": "Test assertions defined by a language-neutral standard and held to it",
  "license": "MIT",
  "author": "Dokimasia B.V.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "testing",
    "assertions",
    "test-framework",
    "conformance",
    "vitest",
    "jest",
    "typescript"
  ],
  "homepage": "https://github.com/dokimasia/assert-typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dokimasia/assert-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/dokimasia/assert-typescript/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/index.js"
    },
    "./jest": {
      "types": "./dist/jest.d.ts",
      "require": "./dist/cjs/jest.js",
      "import": "./dist/jest.js"
    },
    "./vitest": {
      "types": "./dist/vitest/vitest5.d.ts",
      "import": "./dist/vitest.js"
    },
    "./vitest4": {
      "types": "./dist/vitest/vitest4.d.ts",
      "import": "./dist/vitest.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node tools/dist.ts",
    "prepack": "npm run build",
    "check": "npm run lint && npm run lint-md && npm run types && npm run build && npm run coverage",
    "coverage": "vitest run --coverage",
    "fmt": "biome check --write src tests tools",
    "lint": "biome check src tests tools",
    "test": "vitest run",
    "types": "tsc --noEmit",
    "lint-md": "npx --yes markdownlint-cli '**/*.md' --ignore node_modules --ignore dist",
    "api-docs": "npm run build && node tools/api-reference.ts --write",
    "spec:sync": "spec sync",
    "spec:check": "spec check"
  },
  "peerDependencies": {
    "@jest/globals": "^29.7.0 || ^30.5.2",
    "jest": "^29.7.0 || ^30.5.2",
    "vitest": "^4.1.11 || ^5.0.3"
  },
  "peerDependenciesMeta": {
    "@jest/globals": {
      "optional": true
    },
    "jest": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@jest/globals": "30.5.2",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.12",
    "expect": "30.5.2",
    "jest": "30.5.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
