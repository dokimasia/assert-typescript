{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/.ergon",
      "!src/conformance/spec",
      "!src/conformance/corpus",
      "!src/conformance/overlays",
      "!src/conformance/manifest.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 88
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "domains": {
      "project": "all",
      "types": "all"
    },
    "rules": {
      "a11y": "error",
      "complexity": "error",
      "correctness": {
        "useImportExtensions": {
          "level": "error",
          "options": {
            "extensionMappings": {
              "ts": "js",
              "tsx": "js",
              "mts": "mjs",
              "cts": "cjs"
            }
          }
        }
      },
      "performance": "error",
      "security": "error",
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": [
                  "camelCase",
                  "CONSTANT_CASE",
                  "PascalCase",
                  "snake_case"
                ]
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": [
                  "camelCase",
                  "snake_case"
                ]
              }
            ]
          }
        }
      },
      "suspicious": "error"
    }
  },
  "overrides": [
    {
      "includes": [
        "**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          },
          "correctness": "error",
          "style": "error"
        }
      }
    },
    {
      "includes": [
        "**/tests/**",
        "**/*.test.*",
        "**/*.spec.*"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off",
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": [
        "biome.json"
      ],
      "json": {
        "formatter": {
          "expand": "always"
        }
      }
    }
  ]
}
