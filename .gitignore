# Managed by ergon init, with .ergon/local/.gitignore merged in. Change the repository's settings there and run ergon init sync.

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Agents
.claude/
.codex/
.gemini/
AGENT.md
CLAUDE.md
GEMINI.md

# Operating systems
.DS_Store
Thumbs.db

# Secrets
.env
*.local
secrets.json

# ergon release
# The publish plan of the release workflow, which a build of a release must not see as a change
/publish-plan.json

# JavaScript and TypeScript
node_modules/
dist/
coverage/

# TypeScript
*.tsbuildinfo

# The tarball of npm pack
*.tgz

# Zed: settings.json points the editor at the TypeScript of the workspace and picks the formatter.
# Nothing else in .zed is shared.
.zed/*
!.zed/settings.json
